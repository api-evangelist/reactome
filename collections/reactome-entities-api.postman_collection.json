          "name": "A list with the entities contained in a given complex",
          "request": {
            "name": "A list with the entities contained in a given complex",
            "description": {
              "content": "Retrieves the list of subunits that constitute any given complex. In case the complex comprises other complexes, this method recursively traverses the content returning each contained PhysicalEntity. Contained complexes and entity sets can be excluded setting the 'excludeStructures' optional parameter to 'true'",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "complex",
                ":id",
                "subunits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "excludeStructures",
                  "value": "false",
                  "description": "Specifies whether contained complexes and entity sets are excluded in the response"
                },
                {
                  "disabled": false,
                  "key": "view",
                  "value": "flatten",
                  "description": "Global parameter - Customise the view to be more concise and/or aggregate relationships"
                },
                {
                  "disabled": false,
                  "key": "includeRef",
                  "value": "false",
                  "description": "Global parameter - If true, replace element ref to dbId by standard JSOG object {@ref}"
                }
              ],
              "variable": [
                {
                  "disabled": false,
