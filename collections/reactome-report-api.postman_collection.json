                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "fireworksProfile",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "token",
                  "description": "(Required) The token associated with the data to query"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "species",
                  "description": "(Required) The species for which results will be reported"
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
