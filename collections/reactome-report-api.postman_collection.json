          "name": "Downloads a report for a given pathway analysis result",
          "request": {
            "name": "Downloads a report for a given pathway analysis result",
            "description": {
              "content": "This method provides a report for a given pathway analysis result in a PDF document. This document contains data about the analysis itself followed by the pathways overview and the most significant pathways overlaid with the analysis result. Users can download and store this information in a convenient format to be checked in the future when the 'token' is not longer available.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "report",
                ":token",
                ":species",
                "{{filename}}.pdf"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "number",
                  "value": "25",
                  "description": "Number of pathways reported (max 50)"
                },
                {
                  "disabled": false,
                  "key": "resource",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "importableOnly",
                  "value": "false",
                  "description": "Filters resources to only includes importable ones"
                },
                {
