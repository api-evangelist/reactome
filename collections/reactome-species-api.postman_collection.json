            },
            "url": {
              "path": [
                "species",
                "homoSapiens",
                ":species"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "<integer>",
                  "description": "pathways per page"
                },
                {
                  "disabled": false,
                  "key": "page",
